<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <application>
        <provider android:name="com.pixel.gallery.integration.ThumbnailQualityProvider"
            android:authorities="${applicationId}.thumbnailquality"
            android:exported="true" />
        <!-- Test APK only: serves generated bytes and simulated stream failures, never user files. -->
        <provider android:name="com.pixel.gallery.integration.BackupFaultProvider"
            android:authorities="${applicationId}.backupfault"
            android:exported="true" />
        <provider android:name="com.pixel.gallery.integration.TransferFaultDocumentsProvider"
            android:authorities="${applicationId}.transferfault"
            android:exported="true" android:grantUriPermissions="true" />
    </application>
</manifest>
